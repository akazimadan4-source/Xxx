local Window = Library:CreateWindow({
    Title = "Rabbit Ware",
    Center = true,
    AutoShow = true,
})

local Tabs = {
    AutoFarm = Window:AddTab("Auto Farm"),
    Settings = Window:AddTab("Settings"),
}

local Left = Tabs.AutoFarm:AddLeftGroupbox("Mop Farm")

