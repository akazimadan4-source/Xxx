    Rounding=1
})

Mid:AddButton("Request Mop",function()
end)

Mid:AddButton("Teleport To Dirt",function()
end)

Mid:AddButton("Force Hold",function()
end)

local Right = Tabs.AutoFarm:AddRightGroupbox("Stats")

Right:AddLabel("Cycles : 0")
Right:AddLabel("Dirts Cleaned : 0")
