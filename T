-- ========================================
-- Utilitas Deteksi Fire Rate
-- ========================================

-- Cari properti fire rate dengan berbagai cara
local function findFireRateProperty(tool)
    -- 1. Cari NumberValue / IntValue / FloatValue
    for _, child in ipairs(tool:GetDescendants()) do
        if child:IsA("NumberValue") or child:IsA("IntValue") or child:IsA("FloatValue") then
            local name = child.Name:lower()
            if name:find("rate") or name:find("cooldown") or name:find("firerate") or name:find("delay") or name:find("fire") then
                return child, "value"
            end
        end
    end

    -- 2. Cek Attribute "FireRate" atau "Rate"
    local attrNames = {"FireRate", "Rate", "Cooldown", "FireDelay"}
    for _, attr in ipairs(attrNames) do
        if tool:GetAttribute(attr) ~= nil then
            return tool, "attribute", attr
        end
    end

    -- 3. Coba cari di tool langsung (misal tool.FireRate)
    if tool:FindFirstChild("FireRate") and (tool.FireRate:IsA("NumberValue") or tool.FireRate:IsA("IntValue")) then
        return tool.FireRate, "value"
    end

    -- 4. Coba cari di tool:WaitForChild("Cooldown")?
    return nil, nil
end

-- Fungsi untuk mendapatkan nilai default
local function getDefaultRate(tool)
    local prop, propType, attrName = findFireRateProperty(tool)
    if not prop then return nil end

    if propType == "value" then
        return prop.Value
    elseif propType == "attribute" then
        return tool:GetAttribute(attrName)
    end
    return nil
end

-- Fungsi untuk mengatur nilai fire rate
local function setFireRate(tool, value)
    local prop, propType, attrName = findFireRateProperty(tool)
    if not prop then return false end

    if propType == "value" then
        prop.Value = value
        return true
    elseif propType == "attribute" then
        tool:SetAttribute(attrName, value)
        return true
    end
    return false
end

-- Aktifkan rapid fire pada tool
local function enableRapidFire(tool)
    if not tool then return end

    -- Simpan default jika belum
    if state.defaultRates[tool] == nil then
        local default = getDefaultRate(tool)
        if default ~= nil then
            state.defaultRates[tool] = default
        else
            -- Jika tidak ada, kita skip (tool tidak support)
            return
        end
    end

    setFireRate(tool, state.fireRate)
end

-- Nonaktifkan rapid fire (restore default)
local function disableRapidFire(tool)
    if not tool then return end
    local default = state.defaultRates[tool]
    if default ~= nil then
        setFireRate(tool, default)
        state.defaultRates[tool] = nil
    end
end

-- Proses semua tool di karakter
local function processAllTools(character)
    if not character then return end
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            if state.enabled then
                enableRapidFire(child)
            else
                disableRapidFire(child)
            end
        end
    end
end

-- ========================================
-- Event Handlers
-- ========================================
local function onCharacterAdded(character)
    processAllTools(character)

    character.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            if state.enabled then
                enableRapidFire(child)
            else
                disableRapidFire(child)
            end
        end
    end)
end

if localPlayer.Character then
    onCharacterAdded(localPlayer.Character)
end
localPlayer.CharacterAdded:Connect(onCharacterAdded)

